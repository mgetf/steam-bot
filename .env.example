# Steam account credentials
STEAM_ACCOUNT_NAME=your_bot_account_name
STEAM_PASSWORD=your_bot_password

# Steam Guard secrets (from SDA .maFile)
STEAM_SHARED_SECRET=your_shared_secret_here=
STEAM_IDENTITY_SECRET=your_identity_secret_here=

# mge.tf API (generate key in Admin → Site → API Keys)
MGE_API_URL=https://mge.tf
MGE_API_KEY=mge_your_api_key_here

# Comma-separated Steam64 IDs of bot owners (optional)
# BOT_OWNER_IDS=76561198000000001,76561198000000002
