    "steam-user": "^5.3.0",
    "steamcommunity": "^3.49.0",
    "steamid": "^2.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/steam-totp": "^2.1.2",
    "@types/steam-tradeoffer-manager": "^2.11.2",
    "@types/steam-user": "^5.1.1",
    "@types/steamcommunity": "^3.43.8",
    "@types/steamid": "^2.0.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
