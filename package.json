{
  "name": "steam-bot",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node --import tsx/esm src/index.ts",
    "dev": "node --env-file=.env --import tsx/esm src/index.ts",
    "lint": "eslint src/",
