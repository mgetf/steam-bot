    "steam-totp": "^2.1.2",
    "steam-tradeoffer-manager": "^2.13.0",
    "steam-user": "^5.3.0",
    "steamcommunity": "^3.50.3",
    "steamid": "^2.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/steam-totp": "^2.1.2",
    "@types/steam-tradeoffer-manager": "^2.11.2",
    "@types/steam-user": "^5.1.1",
    "@types/steamcommunity": "^3.50.0",
    "@types/steamid": "^2.0.4",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
